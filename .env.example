# Copy to .env.local (and add the same values in Vercel → Settings → Environment Variables).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The one email allowed to sign in to /write (must match the email in
# supabase/migrations/0001_case_studies.sql).
ADMIN_EMAIL=you@example.com

# Sending email from the site (the contact form and case-study requests), through Gmail
# with an app password (myaccount.google.com/apppasswords), never the account
# password. Request details go to LEAD_NOTIFY_EMAIL (defaults to ADMIN_EMAIL).
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
LEAD_NOTIFY_EMAIL=

# Optional, already used by the site.
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_LINKEDIN_URL=
# NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
